# 复制为 .env.local 后按需填写（.env.local 不入 git）。

# ── 开发代理目标（联调必填）────────────────────────────────────────────────
# 两个后端面必须是两个独立端点（/agent-api 会被 rewrite 成 /api，共用会撞路径）。
# 托管 dev API 地址向仓库维护者索取；本机联调时保持默认即可。
DLJY_DEV_API_TARGET=http://127.0.0.1:4174
DLJY_AGENT_API_TARGET=http://127.0.0.1:8000
# pi-poc 编排服务（战略问答/申报体检/智能体工作台的 /pi-api 代理目标；不跑可保持默认）
DLJY_PI_POC_TARGET=http://127.0.0.1:8100
# 数据服务（数据管理路径族经 /data-svc 代理；不跑可保持默认）
DLJY_DATA_SVC_TARGET=http://127.0.0.1:8190

# ── 接口基址（生产/预览部署时用，开发态走上面的代理即可）────────────────────
# Node API 基址（默认 /api）
VITE_API_BASE=
# 智能体后端基址（默认 /agent-api；改动前先读 src/services 的 AGENT_API_BASE 约定）
VITE_AGENT_API_BASE=

# ── 功能开关 ────────────────────────────────────────────────────────────────
# 恢复 /demo/* 展示页（默认关；关闭时根路径 / 落 /dashboard）
VITE_ENABLE_DEMO_PAGES=0
# 恢复「测算工具」分组（默认摘除，路由深链仍可达）
VITE_ENABLE_CALCULATORS_NAV=0
# 恢复「地区通用」分组（默认摘除）
VITE_ENABLE_REGION_COMMON_NAV=0
# 云南市场洞察工作区（dljy#2995 新版六页）：已于 2026-09-28 封存（dljy#3387），保持 0、不要打开。
# 仅 UI 装配开关，不是授权开关；封存说明见 docs/market-insight.md。
VITE_YUNNAN_INSIGHT_WORKSPACE=0
# 关闭报表模块
VITE_DISABLE_REPORTS=
# 关闭云南交易模块
VITE_DISABLE_YUNNAN_TRADING=
# 关闭电厂空间资产（grid-geo）模块
VITE_DISABLE_GRID_GEO=0
# 关闭登录页滑块验证（dev server 下默认已关；生产构建默认开，置 1 关闭）
VITE_DISABLE_LOGIN_CAPTCHA=

# ── 空间资产（grid-geo）渲染配置 ────────────────────────────────────────────
VITE_GRID_GEO_BASEMAP=
VITE_GRID_GEO_TERRAIN_PROVIDER=arcgis-terrain
VITE_GRID_GEO_ARCGIS_TERRAIN_URL=https://elevation3d.arcgis.com/arcgis/rest/services/WorldElevation3D/Terrain3D/ImageServer
# 晕渲（山体阴影）源；留空走内置降级链（server.arcgisonline.com 的 World_Hillshade →
# World_Shaded_Relief）。注意 Esri 的 services.* 子域实测不可达，server.* 才通。
VITE_GRID_GEO_HILLSHADE_URL=
# ArcGIS token（可选；免费源不需要，企业版 ArcGIS Online 才用）
VITE_GRID_GEO_ARCGIS_TOKEN=
# Cesium ion token（可选）：启用带山体阴影的 Cesium World Terrain。
# 这里只是构建期默认值——运行时可在「地形环境」面板里直接填，且以面板填的为准，
# 现场无需重新构建。
VITE_CESIUM_ION_TOKEN=
# 天地图 token（可选）：VITE_GRID_GEO_BASEMAP=tianditu-imagery 时需要（src/config/mapTokens.ts 读取）。
VITE_TIANDITU_TOKEN=
